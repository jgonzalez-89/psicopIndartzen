---
import Image from "astro/components/Image.astro";
import { getCollection } from "astro:content";
import { ChevronRight, Users, Layers, Vote } from "@lucide/astro";
import grupo from "../../assets/equipo/grupo-horizontal.jpg";
import { getLocaleFromUrl, path, useTranslations } from "../../i18n/ui";
import { SITE, CLAIM, ELECTION_YEAR } from "../../consts";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);

const nPersonas = (await getCollection("candidatura")).length;
const nAmbitos = (await getCollection("ambitos", (e) => e.data.lang === lang)).length;

const claim = {
  es: {
    eyebrow: `Elecciones a la Junta de Gobierno · COP Bizkaia ${ELECTION_YEAR}`,
    h1a: "Un Colegio",
    h1b: "participativo",
    h1c: "de tod@s y para tod@s.",
    lead: "Transparencia, profesionalidad, cercanía y atención continuada para las personas colegiadas, desde la diversidad de todos los ámbitos de la Psicología.",
    personas: "personas en la candidatura",
    ambitos: "ámbitos representados",
    elecciones: `Elecciones ${ELECTION_YEAR}`,
    eleccionesSub: "Junta de Gobierno del COP Bizkaia",
  },
  eu: {
    eyebrow: `Gobernu Batzarrerako hauteskundeak · Bizkaiko PE ${ELECTION_YEAR}`,
    h1a: "Elkargo",
    h1b: "parte-hartzailea",
    h1c: "guztiona eta guztiontzat.",
    lead: "Gardentasuna, profesionaltasuna, hurbiltasuna eta elkargokideenganako etengabeko arreta, Psikologiaren arlo guztien aniztasunetik.",
    personas: "pertsona hautagaitzan",
    ambitos: "arlo ordezkatuta",
    elecciones: `${ELECTION_YEAR}ko hauteskundeak`,
    eleccionesSub: "Bizkaiko PEko Gobernu Batzarra",
  },
}[lang];
---

<section class="relative pt-10 pb-16 sm:pt-16 lg:pt-20 lg:pb-28" data-hero>
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.15fr] items-center gap-12 lg:gap-10">
      <!-- Texto -->
      <div class="text-center lg:text-left">
        <p class="eyebrow fade-up justify-center lg:justify-start">{claim.eyebrow}</p>
        <h1 class="mt-5 fade-up fade-up-delay-1">
          {claim.h1a}{" "}
          <span class="text-gradient">{claim.h1b}</span>{" "}
          {claim.h1c}
        </h1>
        <p class="lead mt-6 max-w-xl mx-auto lg:mx-0 fade-up fade-up-delay-2">{claim.lead}</p>
        <p class="mt-6 text-xl font-semibold text-accent-green-dark italic fade-up fade-up-delay-2">
          «{CLAIM[lang]}»
        </p>
        <div class="flex flex-wrap gap-4 mt-10 justify-center lg:justify-start fade-up fade-up-delay-3">
          <a href={path(lang, "candidatura")} class="btn-accent btn-lg">
            {t("cta.verCandidatura")} <ChevronRight size={20} />
          </a>
          <a href={path(lang, "ambitos")} class="btn-outline-brand btn-lg">{t("ambitos.titulo")}</a>
        </div>
      </div>

      <!-- Composición visual: escena 3D con parallax suave y tarjetas flotando. -->
      <div class="hero-scene relative mx-auto w-full max-w-xl lg:max-w-none px-5 sm:px-8 lg:pl-10 lg:pr-6 pt-8 pb-10 fade-up fade-up-delay-2">
        <div class="hero-tilt relative" data-tilt>
          <!-- Marco de color detrás de la foto, girado ligeramente. -->
          <div
            aria-hidden="true"
            class="hero-layer absolute -inset-3 sm:-inset-4 rounded-[2rem] bg-[linear-gradient(135deg,var(--color-brand-400),var(--color-brand-900))] rotate-[-3deg] opacity-90"
            style="--depth: -40px"
          >
          </div>
          <div aria-hidden="true" class="hero-layer absolute -top-12 -right-10 w-40 h-40 bg-dots rounded-full opacity-80" style="--depth: 10px"></div>
          <div aria-hidden="true" class="hero-layer absolute -bottom-10 -left-12 w-32 h-32 rounded-full bg-accent-orange/25 blur-2xl" style="--depth: -20px"></div>

          <Image
            src={grupo}
            alt={SITE[lang].tagline}
            widths={[600, 900, 1200]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            format="webp"
            quality={75}
            fetchpriority="high"
            loading="eager"
            class="hero-layer relative w-full h-auto rounded-[1.75rem] shadow-brand-lg object-cover"
            style="--depth: 0px"
          />

          <!-- Tarjetas flotantes: se apoyan en los bordes de la foto, no encima. -->
          <div
            class="hero-layer hero-float absolute -left-5 sm:-left-8 lg:-left-9 bottom-14 sm:bottom-20 card-soft px-4 py-3 sm:px-5 sm:py-4 flex items-center gap-3 bg-white/95 backdrop-blur"
            style="--depth: 70px; --float-dur: 6s; --float-delay: 0s"
          >
            <span class="grid place-items-center w-11 h-11 rounded-2xl bg-brand-50 text-brand-500">
              <Users size={22} />
            </span>
            <div>
              <p class="text-2xl font-bold text-brand-900 leading-none">{nPersonas}</p>
              <p class="text-xs text-slate-500 mt-1 whitespace-nowrap">{claim.personas}</p>
            </div>
          </div>

          <div
            class="hero-layer hero-float absolute -right-5 sm:-right-8 lg:-right-6 -top-6 sm:-top-8 card-soft px-4 py-3 sm:px-5 sm:py-4 flex items-center gap-3 bg-white/95 backdrop-blur"
            style="--depth: 90px; --float-dur: 7s; --float-delay: -2.5s"
          >
            <span class="grid place-items-center w-11 h-11 rounded-2xl bg-accent-green/10 text-accent-green-dark">
              <Layers size={22} />
            </span>
            <div>
              <p class="text-2xl font-bold text-brand-900 leading-none">{nAmbitos}</p>
              <p class="text-xs text-slate-500 mt-1 whitespace-nowrap">{claim.ambitos}</p>
            </div>
          </div>

          <div
            class="hero-layer hero-float hidden sm:flex absolute right-8 -bottom-9 card-soft px-5 py-3 items-center gap-3 bg-brand-900 border-brand-900 text-white"
            style="--depth: 50px; --float-dur: 8s; --float-delay: -4s"
          >
            <Vote size={20} class="text-accent-orange" />
            <div>
              <p class="font-bold leading-none">{claim.elecciones}</p>
              <p class="text-xs text-white/70 mt-1 whitespace-nowrap">{claim.eleccionesSub}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Escena 3D: la perspectiva vive en el contenedor y las capas se reparten en
     profundidad con --depth. Sin ratón (táctil) o con reduced-motion, solo flotan. */
  .hero-scene {
    perspective: 1400px;
  }
  .hero-tilt {
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.15s ease-out;
    will-change: transform;
  }
  .hero-layer {
    transform: translateZ(var(--depth, 0px));
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-float {
      animation: hero-float var(--float-dur, 6s) ease-in-out var(--float-delay, 0s) infinite;
    }
    @keyframes hero-float {
      0%,
      100% {
        translate: 0 0;
        rotate: 0deg;
      }
      50% {
        translate: 0 -10px;
        rotate: -1deg;
      }
    }
  }
</style>

<script>
  // Parallax 3D suave siguiendo el ratón. Solo con puntero fino y sin reduced-motion.
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const tilt = hero?.querySelector<HTMLElement>("[data-tilt]");

  if (fine && !reduce && hero && tilt) {
    let raf = 0;
    let rx = 0;
    let ry = 0;
    const MAX = 6; // grados

    const apply = () => {
      tilt.style.setProperty("--rx", `${rx.toFixed(2)}deg`);
      tilt.style.setProperty("--ry", `${ry.toFixed(2)}deg`);
      raf = 0;
    };

    hero.addEventListener("pointermove", (e) => {
      const r = tilt.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      // -1..1 respecto al centro de la escena, limitado para movimientos lejanos.
      const dx = Math.max(-1, Math.min(1, (e.clientX - cx) / (r.width * 0.9)));
      const dy = Math.max(-1, Math.min(1, (e.clientY - cy) / (r.height * 0.9)));
      ry = dx * MAX;
      rx = -dy * MAX;
      if (!raf) raf = requestAnimationFrame(apply);
    });

    hero.addEventListener("pointerleave", () => {
      rx = 0;
      ry = 0;
      tilt.style.transition = "transform 0.6s ease-out";
      if (!raf) raf = requestAnimationFrame(apply);
      setTimeout(() => (tilt.style.transition = ""), 600);
    });
  }
</script>
