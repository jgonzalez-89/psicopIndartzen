---
import Logo from "./Logo.astro";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import { getCollection } from "astro:content";
import { Mail, Phone, ExternalLink } from "@lucide/astro";
import { getLocaleFromUrl, path, useTranslations } from "../i18n/ui";
import { SITE, SITE_NAME, COPB_URL, CONTACT, ELECTION_YEAR } from "../consts";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const ambitos = (await getCollection("ambitos", (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const linkClass = "text-slate-600 hover:text-brand-700 hover:translate-x-0.5 inline-flex items-center gap-1.5 transition-all";
---

<footer class="relative w-full bg-brand-50 border-t border-brand-100 overflow-hidden">
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-[linear-gradient(90deg,var(--color-brand-900),var(--color-brand-400),var(--color-accent-green),var(--color-accent-orange))]"></div>
  <div class="w-full pt-16 pb-12">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_2fr] gap-12">
        <div>
          <Logo variant="claim" />
          <p class="mt-5 max-w-sm text-slate-600">{SITE[lang].tagline}</p>
          <div class="mt-6"><LocaleSwitcher /></div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-10">
          <div>
            <h3 class="text-base uppercase tracking-widest text-brand-900 mb-4">{t("nav.ambitos")}</h3>
            <nav class="grid gap-3">
              {
                ambitos.map((a) => (
                  <a href={path(lang, "ambitos", a.data.key)} class={linkClass}>
                    {a.data.title}
                  </a>
                ))
              }
            </nav>
          </div>
          <div>
            <h3 class="text-base uppercase tracking-widest text-brand-900 mb-4">{SITE_NAME}</h3>
            <nav class="grid gap-3">
              <a href={path(lang, "candidatura")} class={linkClass}>{t("nav.candidatura")}</a>
              <a href={path(lang, "noticias")} class={linkClass}>{t("nav.noticias")}</a>
              <a href={path(lang, "contacto")} class={linkClass}>{t("nav.contacto")}</a>
              <a href={COPB_URL} rel="noopener noreferrer" target="_blank" class={linkClass}>
                COP Bizkaia <ExternalLink size={14} />
              </a>
            </nav>
          </div>
          <div>
            <h3 class="text-base uppercase tracking-widest text-brand-900 mb-4">{t("nav.contacto")}</h3>
            <nav class="grid gap-3">
              {
                CONTACT.email ? (
                  <a href={`mailto:${CONTACT.email}`} class={linkClass}>
                    <Mail size={16} /> {CONTACT.email}
                  </a>
                ) : null
              }
              {
                CONTACT.phone ? (
                  <a href={`tel:${CONTACT.phone.replace(/\s+/g, "")}`} class={linkClass}>
                    <Phone size={16} /> {CONTACT.phone}
                  </a>
                ) : null
              }
              <a href={path(lang, "contacto")} class="btn-outline-brand text-sm px-4 py-2 w-fit mt-1">
                {lang === "eu" ? "Idatzi iezaguzu" : "Escríbenos"}
              </a>
              <!-- TODO: añadir redes sociales en CONTACT (src/consts.ts) cuando las faciliten. -->
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-full border-t border-brand-100 py-6">
    <div class="container flex flex-col sm:flex-row gap-2 justify-between text-sm text-slate-500">
      <p>© {year} {SITE_NAME}. {t("footer.derechos")}</p>
      <p>{lang === "eu" ? `${ELECTION_YEAR}ko hauteskundeak` : `Elecciones ${ELECTION_YEAR}`}</p>
    </div>
  </div>
</footer>
