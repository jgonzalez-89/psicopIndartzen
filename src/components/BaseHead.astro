---
// Se importa global.css aquí para que llegue a todas las páginas.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import FallbackImage from "../assets/og_1200x630.jpg";
import LogoImage from "../assets/brand/isotipo.svg";
import { SITE, SITE_NAME, COPB_URL, CONTACT } from "../consts";
import { getLocaleFromUrl, LOCALES, switchLocalePath } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  /** Imagen de compartición: un asset del proyecto o la ruta de una OG generada en /og/. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** Los buscadores distinguen una noticia (`article`) o una ficha (`profile`) de una página normal. */
  ogType?: "website" | "article" | "profile";
  publishedTime?: Date;
  modifiedTime?: Date;
}

const lang = getLocaleFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title = SITE[lang].title,
  description = SITE[lang].description,
  image = FallbackImage,
  imageAlt,
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = title === SITE_NAME ? `${SITE_NAME} · ${SITE[lang].tagline}` : `${title} · ${SITE_NAME}`;

// Las redes exigen un formato horizontal (1.91:1) y descartan las imágenes que
// no pueden medir, así que toda OG se normaliza a 1200×630 JPEG y se declara
// con sus dimensiones. Las tarjetas de /og/ ya vienen con ese tamaño.
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const ogImage =
  typeof image === "string"
    ? image
    : (await getImage({ src: image, width: OG_WIDTH, height: OG_HEIGHT, fit: "cover", format: "jpeg", quality: 82 }))
        .src;

// Absoluta y contra el dominio canónico: los rastreadores no resuelven rutas relativas.
const ogImageURL = new URL(ogImage, Astro.site);
const ogImageAlt = imageAlt ?? fullTitle;

const jsonLd = {
  "@context": "https://schema.org/",
  "@type": "Organization",
  name: SITE_NAME,
  alternateName: "PsiCop Indartzen",
  url: Astro.site?.href,
  logo: new URL(LogoImage.src, Astro.site).href,
  image: ogImageURL.href,
  description: SITE[lang].description,
  areaServed: "Bizkaia",
  memberOf: { "@type": "Organization", name: "Colegio Oficial de Psicología de Bizkaia", url: COPB_URL },
  ...(CONTACT.email ? { email: CONTACT.email } : {}),
};
---

<!-- Metadatos globales -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
<link rel="icon" href="/favicon/favicon.ico" />
<link rel="manifest" href="/favicon/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_NAME}
  href={new URL(`rss-${lang}.xml`, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<link rel="canonical" href={canonicalURL} />
{
  LOCALES.map((loc) => (
    <link rel="alternate" hreflang={loc} href={new URL(switchLocalePath(Astro.url, loc), Astro.site)} />
  ))
}
<link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url, "es"), Astro.site)} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={lang === "eu" ? "eu_ES" : "es_ES"} />
<meta property="og:locale:alternate" content={lang === "eu" ? "es_ES" : "eu_ES"} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={OG_WIDTH} />
<meta property="og:image:height" content={OG_HEIGHT} />
<meta property="og:image:alt" content={ogImageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter / X: estas etiquetas se declaran con `name`, no con `property`. -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
