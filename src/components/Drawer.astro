---
import HeaderLink from "./HeaderLink.astro";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import Logo from "./Logo.astro";
import { getLocaleFromUrl, path, useTranslations } from "../i18n/ui";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="drawer-side z-50">
  <label for="my-drawer-2" aria-label="close sidebar" class="drawer-overlay">
    <span class="sr-only">{t("nav.inicio")}</span>
  </label>
  <nav class="menu bg-white min-h-full w-80 p-6 flex flex-col gap-2 text-lg">
    <Logo class="max-w-[180px]" />
    <hr class="border-brand-100 my-4" />
    <HeaderLink href={path(lang)}>{t("nav.inicio")}</HeaderLink>
    <HeaderLink href={path(lang, "candidatura")}>{t("nav.candidatura")}</HeaderLink>
    <HeaderLink href={path(lang, "ambitos")}>{t("nav.ambitos")}</HeaderLink>
    <HeaderLink href={path(lang, "noticias")}>{t("nav.noticias")}</HeaderLink>
    <HeaderLink href={path(lang, "contacto")}>{t("nav.contacto")}</HeaderLink>
    <hr class="border-brand-100 my-4" />
    <a href={path(lang, "candidatura")} class="btn-accent">{t("cta.verCandidatura")}</a>
    <div class="mt-4"><LocaleSwitcher /></div>
  </nav>
</div>
