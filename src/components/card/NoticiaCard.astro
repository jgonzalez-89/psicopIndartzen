---
import type { CollectionEntry } from "astro:content";
import Image from "astro/components/Image.astro";
import { ArrowRight, Newspaper } from "@lucide/astro";
import FormattedDate from "../FormattedDate.astro";
import { type Locale, path, useTranslations } from "../../i18n/ui";

interface Props {
  noticia: CollectionEntry<"blog">;
  lang: Locale;
}

const { noticia, lang } = Astro.props;
const t = useTranslations(lang);
// El id incluye la carpeta de idioma: "es/mi-noticia" -> "mi-noticia".
const slug = noticia.id.split("/").pop()!;
---

<article class="group card-soft card-lift overflow-hidden flex flex-col">
  <a href={path(lang, "noticias", slug)} class="flex flex-col h-full">
    <div class="relative overflow-hidden">
      {
        noticia.data.heroImage ? (
          <Image
            src={noticia.data.heroImage}
            alt={noticia.data.title}
            widths={[400, 800]}
            sizes="(max-width: 640px) 100vw, 400px"
            format="webp"
            quality={70}
            class="w-full aspect-[16/10] object-cover transition-transform duration-500 group-hover:scale-105"
          />
        ) : (
          <div class="w-full aspect-[16/10] grid place-items-center bg-[linear-gradient(135deg,var(--color-brand-50),var(--color-brand-100))] text-brand-400">
            <Newspaper size={48} strokeWidth={1.25} />
          </div>
        )
      }
      <span class="absolute top-3 left-3 rounded-full bg-white/90 backdrop-blur px-3 py-1 text-xs font-semibold text-brand-700 shadow-sm">
        <FormattedDate date={noticia.data.pubDate} />
      </span>
    </div>
    <div class="p-6 flex flex-col flex-1">
      <h3 class="text-xl mb-2 group-hover:text-brand-500 transition-colors">{noticia.data.title}</h3>
      <p class="text-slate-600 flex-1">{noticia.data.description}</p>
      <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-500 group-hover:gap-2 transition-all">
        {t("cta.leerMas")} <ArrowRight size={16} />
      </span>
    </div>
  </a>
</article>
