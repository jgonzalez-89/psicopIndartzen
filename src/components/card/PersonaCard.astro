---
import type { CollectionEntry } from "astro:content";
import Image from "astro/components/Image.astro";
import { UserRound, ArrowUpRight } from "@lucide/astro";
import { type Locale, path } from "../../i18n/ui";

interface Props {
  persona: CollectionEntry<"candidatura">;
  lang: Locale;
  destacada?: boolean;
}

const { persona, lang, destacada = false } = Astro.props;
const { nombre, cargo, image } = persona.data;
---

<a
  href={path(lang, "candidatura", persona.id)}
  class:list={[
    "group card-soft card-lift relative overflow-hidden flex flex-col",
    destacada && "sm:col-span-2 sm:grid sm:grid-cols-[minmax(0,280px)_1fr] lg:grid-cols-[minmax(0,320px)_1fr]",
  ]}
>
  <div class="relative overflow-hidden">
    {
      image ? (
        <Image
          src={image}
          alt={nombre}
          widths={[300, 600]}
          sizes={destacada ? "320px" : "(max-width: 640px) 100vw, 320px"}
          format="webp"
          quality={72}
          class:list={[
            "w-full object-cover object-top transition-transform duration-500 group-hover:scale-105",
            destacada ? "aspect-[3/4] sm:h-full" : "aspect-[3/4]",
          ]}
        />
      ) : (
        <div
          class="w-full aspect-[3/4] grid place-items-center bg-[linear-gradient(135deg,var(--color-brand-50),var(--color-brand-100))] text-brand-400"
          role="img"
          aria-label={nombre}
        >
          <UserRound size={72} aria-hidden="true" strokeWidth={1.25} />
        </div>
      )
    }
    <span
      class="absolute top-3 left-3 inline-flex items-center rounded-full bg-white/90 backdrop-blur px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-accent-green-dark shadow-sm"
    >
      {cargo[lang]}
    </span>
  </div>
  <div class:list={["p-5 flex items-start justify-between gap-3", destacada && "sm:p-8 sm:self-center"]}>
    <div>
      <h3 class:list={["mb-0 group-hover:text-brand-500 transition-colors", destacada ? "text-2xl sm:text-3xl" : "text-lg"]}>
        {nombre}
      </h3>
      {
        destacada && persona.data.bio.es[0] && (
          <p class="mt-3 text-slate-600 line-clamp-4 hidden sm:block">{persona.data.bio[lang]?.[0] ?? persona.data.bio.es[0]}</p>
        )
      }
    </div>
    <ArrowUpRight
      size={20}
      class="shrink-0 text-brand-300 group-hover:text-brand-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all"
      aria-hidden="true"
    />
  </div>
</a>
