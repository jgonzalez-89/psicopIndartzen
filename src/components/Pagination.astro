---
import { ChevronRight, ChevronLeft } from "@lucide/astro";
import { getLocaleFromUrl } from "../i18n/ui";

const { page } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);

const label = {
  es: { prev: "Anterior", next: "Siguiente", of: (c: number, l: number) => `Página ${c} de ${l}` },
  eu: { prev: "Aurrekoa", next: "Hurrengoa", of: (c: number, l: number) => `${c}. orria / ${l}` },
}[lang];
---

{
  page.lastPage > 1 && (
    <nav class="mt-16 flex items-center justify-center gap-4" aria-label={label.of(page.currentPage, page.lastPage)}>
      {page.url.prev && (
        <a href={page.url.prev} class="btn-outline-brand" rel="prev">
          <ChevronLeft size={18} />
          {label.prev}
        </a>
      )}

      <span class="text-sm text-slate-500">{label.of(page.currentPage, page.lastPage)}</span>

      {page.url.next && (
        <a href={page.url.next} class="btn-outline-brand" rel="next">
          {label.next} <ChevronRight size={18} />
        </a>
      )}
    </nav>
  )
}
