---
// Raíz del sitio: redirige al idioma por defecto (castellano).
// Astro necesita este archivo para generar la redirección de `/` a `/es/`.
import { DEFAULT_LOCALE } from "../consts";

const target = `/${DEFAULT_LOCALE}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>PsiCopIndartzen</title>
  </head>
  <body>
    <a href={target}>PsiCopIndartzen</a>
  </body>
</html>
