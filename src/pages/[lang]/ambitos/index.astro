---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/MainLayout.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import AmbitoCard from "../../../components/card/AmbitoCard.astro";
import CtaBand from "../../../components/CtaBand.astro";
import { LOCALES, type Locale, useTranslations } from "../../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const ambitos = (await getCollection("ambitos", (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const titulo = t("ambitos.titulo");
---

<Layout title={titulo} description={t("ambitos.intro")}>
  <section class="section">
    <div class="container">
      <SectionHeading as="h1" eyebrow={t("nav.ambitos")} title={titulo} highlight={titulo.split(" ").slice(-1)[0]} lead={t("ambitos.intro")} />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-12 max-w-5xl mx-auto">
        {ambitos.map((a) => <AmbitoCard ambito={a} lang={lang} as="h2" />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
