---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { ChevronLeft } from "@lucide/astro";
import Layout from "../../../layouts/MainLayout.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import { type Locale, path, useTranslations } from "../../../i18n/ui";

export async function getStaticPaths() {
  const noticias = await getCollection("blog");
  return noticias.map((noticia) => ({
    params: { lang: noticia.data.lang, slug: noticia.id.split("/").pop()! },
    props: { noticia },
  }));
}

const lang = Astro.params.lang as Locale;
const { noticia } = Astro.props;
const { Content } = await render(noticia);
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, heroImage } = noticia.data;
---

<Layout title={title} description={description} image={heroImage}>
  <div class="container py-10 lg:py-16 max-w-4xl">
    <a href={path(lang, "noticias")} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-500 hover:text-brand-900 mb-10">
      <ChevronLeft size={18} />{t("cta.volver")}
    </a>
    <article>
      <div class="text-center max-w-3xl mx-auto">
        <p class="eyebrow justify-center"><FormattedDate date={pubDate} /></p>
        <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl">{title}</h1>
        <p class="lead mt-4">{description}</p>
      </div>
      {
        heroImage && (
          <Image
            width={1020}
            height={510}
            src={heroImage}
            format="webp"
            quality={72}
            alt=""
            class="rounded-3xl aspect-2/1 object-cover w-full my-12 shadow-brand-lg"
          />
        )
      }
      <div class="page text-lg max-w-3xl mx-auto"><Content /></div>
      {
        updatedDate && (
          <p class="mt-8 text-sm opacity-70">
            {lang === "eu" ? "Azken eguneratzea: " : "Última actualización: "}
            <FormattedDate date={updatedDate} />
          </p>
        )
      }
    </article>
  </div>
</Layout>
