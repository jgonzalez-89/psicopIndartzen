---
import Layout from "../layouts/MainLayout.astro";
import { getLocaleFromUrl, path, useTranslations } from "../i18n/ui";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("500.titulo")} description={t("500.texto")}>
  <section class="section">
    <div class="container text-center py-20">
      <p class="text-7xl font-bold text-brand-400">500</p>
      <h1 class="mt-4">{t("500.titulo")}</h1>
      <p class="lead">{t("500.texto")}</p>
      <a
        href={path(lang)}
        class="btn-brand btn-lg mt-8"
        >{t("nav.inicio")}</a
      >
    </div>
  </section>
</Layout>
